---
import { localeFromPath, ui } from '../i18n/locale';

interface Props {
  href: string;
}

const { href } = Astro.props;
const isExternal = href.startsWith('http');
const target = isExternal ? '_blank' : undefined;
const rel = isExternal ? 'noopener noreferrer' : undefined;
const t = ui[localeFromPath(Astro.url.pathname)];
---

<a href={href} target={target} rel={rel} class:list={[{ 'external-link': isExternal }]}>
  <slot />{isExternal && <span class="sr-only">{t.opensInNewTab}</span>}
</a>
