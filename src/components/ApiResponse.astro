---
import { localeFromPath, ui } from '../i18n/locale';

interface Props {
  status: number;
  body?: unknown;
  headers?: Record<string, string>;
}

const { status, body, headers } = Astro.props;
const t = ui[localeFromPath(Astro.url.pathname)];
const bodyJson = body === null ? t.emptyBody : JSON.stringify(body, null, 2);
---

<div class="api-response">
  <div class="api-response-header">
    <strong style="color: var(--sl-color-gray-2);">{t.httpStatus}</strong>
    <span class="api-response-status" data-status={status}>
      {status}
    </span>
  </div>
  {headers && Object.keys(headers).length > 0 && (
    <ul class="api-response-headers">
      {Object.entries(headers).map(([key, value]) => (
        <li>
          <span class="header-key">{key}:</span>{' '}
          <span class="header-value">{value}</span>
        </li>
      ))}
    </ul>
  )}
  <div class="api-response-divider"></div>
  {body !== undefined && <pre class="api-response-body" set:text={bodyJson} />}
  {body === undefined && <slot />}
</div>
